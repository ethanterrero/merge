EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Stadia Maps client key for real map tiles (O-08). Leave empty for the stylized offline map.
EXPO_PUBLIC_STADIA_KEY=
# Local development only: a Supabase user with a password, so you can sign in without the emailed code
# (README, Dev sign-in). Shown only in `expo start` bundles; a preview or production build refuses to build with these set.
EXPO_PUBLIC_DEV_SIGN_IN_EMAIL=
EXPO_PUBLIC_DEV_SIGN_IN_PASSWORD=
